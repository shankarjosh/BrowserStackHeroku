pipeline {
    agent any
    tools {
        maven 'Maven'
    }
    stages {
        stage('Clean & Compile') {
            steps {
                // Explicitly use the absolute path to cmd.exe
                bat '"C:\\Windows\\System32\\cmd.exe" /c mvn clean compile'
            }
        }
        stage('Run BrowserStack Tests') {
            steps {
                bat '"C:\\Windows\\System32\\cmd.exe" /c mvn test -DsuiteXmlFile=testng.xml'
            }
        }
    }
    post {
        always {
            junit 'target/surefire-reports/*.xml'
        }
    }
}
